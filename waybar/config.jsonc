{
    "height": 34,
    "spacing": 0,

    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad"
    ],

    "modules-center": [
        "clock"
    ],
    "modules-right": [
		"custom/updates",
        "backlight",
        "pulseaudio",
        "network",
        "bluetooth",
        "sway/language",
        "battery",
        "tray",
        "custom/power"
    ],

    "sway/language": {
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
		"format": "{short}",
        "tooltip": false
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "tray": {
        "spacing": 10
    },

    "clock": {
        "format-alt": "{:%d-%m-%Y}",
        "tooltip": false
    },

    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "tooltip": false,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
    	"bat": "BAT1",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "on-click": "nmrs"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol",
		"on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },

    "bluetooth": {
        "format": "{icon}",
        "format-disabled": "󰂲",
        "format-icons": {
            "on": "󰂯",
            "connected": ""
        },
        "tooltip": false,
        "on-click": "blueberry"
    },

    "custom/power": {
        "format": "⏻",    
        "on-click": "~/.config/waybar/power_menu.sh",
        "tooltip": false,
        "align": 0.423
    },
    
	"custom/updates": {
	    "exec": "(checkupdates && yay -Qua) | wc -l",
	    "interval": 360,
	    "format": "  {}",
	    "on-click": "kitty --class floating_term -e yay",
	    "tooltip": false
	}
}
