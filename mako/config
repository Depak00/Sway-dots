font=Roboto 12
width=380
height=180
margin=10
padding=12
border-size=2
border-radius=10
icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b
default-timeout=5000
max-visible=3
layer=overlay
anchor=top-right
sort=-time

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #b4befe

[urgency=low]
background-color=#1e1e2e
text-color=#a6adc8
border-color=#6c7086

[urgency=normal]
background-color=#1e1e2e
text-color=#cdd6f4
border-color=#b4befe

[urgency=critical]
background-color=#1e1e2e
text-color=#f38ba8
border-color=#f38ba8
default-timeout=0
