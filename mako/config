font=Iosevka Term Extended 12
width=380
height=180
margin=10
padding=12
border-size=2
border-radius=6
icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b
default-timeout=5000
max-visible=3
layer=overlay
anchor=top-right
sort=-time

background-color=#1F1F1F
text-color=#FFFFFF
border-color=#FB8C00
progress-color=over #FB8C00

[urgency=low]
background-color=#1F1F1F
text-color=#B3B3B3
border-color=#FB8C00

[urgency=normal]
background-color=#1F1F1F
text-color=#FFFFFF
border-color=#FB8C00

[urgency=critical]
background-color=#1F1F1F
text-color=#FFFFFF
border-color=#F28B82
default-timeout=0
