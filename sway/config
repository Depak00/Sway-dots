### Variables

# Mod key
set $mod Mod4

# Terminal
set $term kitty

# Menu
set $menu fuzzel -I
set $menu_kill fuzzel

# Browser
set $browser firefox
set $private --private-window

# File managers
set $files nemo
set $tfiles yazi



### Input configuration

input type:touchpad {
   dwt enabled
   tap enabled
   natural_scroll enabled
   middle_emulation enabled
}

input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:caps_toggle"
}

focus_follows_mouse no

include ~/.config/sway/config.d/autostart.conf
include ~/.config/sway/config.d/bindings.conf
include ~/.config/sway/config.d/decoration.conf
include ~/.config/sway/config.d/rules.conf
