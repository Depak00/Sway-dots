### Variables

# Mod key
set $mod Mod4

# Terminal
set $term kitty

# Menu
set $menu wofi -a --show=drun
set $menu_kill wofi

# Browser
set $browser firefox

# File managers
set $files nemo
set $tfiles yazi



### Input configuration

input type:touchpad {
   dwt enabled
   tap enabled
   natural_scroll enabled
   middle_emulation enabled
}

input type:keyboard {
    xkb_layout "us,ru"
    xkb_options "grp:caps_toggle"
}



### Key bindings

floating_modifier $mod normal

# Start a terminal
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term --class floating_terminal
for_window [app_id="floating_terminal"] floating enable

# Kill focused window
bindsym --to-code $mod+q kill

# VPN
bindsym --to-code $mod+a exec AmneziaVPN

# Steam
bindsym --to-code $mod+g exec steam

# Start your launcher
bindsym --to-code $mod+d exec "killall $menu_kill; $menu"

# Browser
bindsym --to-code $mod+w exec $browser
bindsym --to-code $mod+shift+w exec $browser --private-window

# File managers
bindsym --to-code $mod+e exec $files
bindsym --to-code $mod+shift+e exec kitty -e $tfiles


# Reload the configuration file
bindsym --to-code $mod+shift+c reload

# Exit sway
bindsym $mod+shift+x exec swaymsg exit

# Focus windows
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+shift+Left move left
bindsym $mod+shift+Down move down
bindsym $mod+shift+Up move up
bindsym $mod+shift+Right move right

# Workspaces:

# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+shift+1 move container to workspace number 1
bindsym $mod+shift+2 move container to workspace number 2
bindsym $mod+shift+3 move container to workspace number 3
bindsym $mod+shift+4 move container to workspace number 4
bindsym $mod+shift+5 move container to workspace number 5
bindsym $mod+shift+6 move container to workspace number 6
bindsym $mod+shift+7 move container to workspace number 7
bindsym $mod+shift+8 move container to workspace number 8
bindsym $mod+shift+9 move container to workspace number 9
bindsym $mod+shift+0 move container to workspace number 10

# Moving to next/previous workspace
bindsym $mod+alt+Right workspace next
bindsym $mod+alt+Left workspace prev

# Move focused container to next/previous workspace
bindsym $mod+alt+shift+Right move container to workspace next
bindsym $mod+alt+shift+Left move container to workspace prev

# Moving to first/last workspace
bindsym $mod+alt+Down exec swaymsg workspace $(swaymsg -t get_workspaces -r | grep -oE '"name"\s*:\s*"[0-9]+"' | grep -oE '[0-9]+' | sort -n | head -1)
bindsym $mod+alt+Up exec swaymsg workspace $(swaymsg -t get_workspaces -r | grep -oE '"name"\s*:\s*"[0-9]+"' | grep -oE '[0-9]+' | sort -n | tail -1)

# Move focused container to first/last workspace
bindsym $mod+alt+shift+Down exec swaymsg move container to workspace $(swaymsg -t get_workspaces -r | grep -oE '"name"\s*:\s*"[0-9]+"' | grep -oE '[0-9]+' | sort -n | head -1)
bindsym $mod+alt+shift+Up exec swaymsg move container to workspace $(swaymsg -t get_workspaces -r | grep -oE '"name"\s*:\s*"[0-9]+"' | grep -oE '[0-9]+' | sort -n | tail -1)

# Fullscreen
bindsym --to-code $mod+f fullscreen

# Toggle floating mode
bindsym $mod+shift+space floating toggle; resize set 800 600

# Toggle focus between modes
bindsym $mod+space focus mode_toggle

# Parent container
bindsym --to-code $mod+p focus parent

# Scratchpad
bindsym $mod+shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Resizing containers
bindsym $mod+Ctrl+Left resize shrink width 10px
bindsym $mod+Ctrl+Down resize grow height 10px
bindsym $mod+Ctrl+Up resize shrink height 10px
bindsym $mod+Ctrl+Right resize grow width 10px

# Brightness
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+

# Volume
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%

# Fullscreen screenshot
bindsym Print exec grim ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png

# Copy part of the screen
bindsym shift+Print exec grim -g "$(slurp)" - | wl-copy

# Save part of screen
bindsym Ctrl+Print exec grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +%Y-%m-%d_%H-%M-%S).png

# Swaylock
bindsym --to-code $mod+l exec swaylock --color 000000 --ring-color ffffff --key-hl-color 000000 --ring-ver-color ffffff --inside-ver-color 000000 --inside-wrong-color 000000 --ring-wrong-color ff0000


### Autostart

# Display
exec kanshi

# Notifications
exec mako

# Polkit
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Copy/paste
exec wl-clip-persist --clipboard regular

# Autotiling
exec autotiling -l 2



### Decorations

# gaps
gaps inner 10
gaps outer 10
smart_gaps true

# bordes
default_border pixel 1
hide_edge_borders smart
default_floating_border pixel 1

# colors
client.focused #ffffff #ffffff #ffffff #ffffff

# wallpaper
output * bg ~/.config/sway/wp.png fill

# Mouse focus
focus_follows_mouse no

# Floating rules
#floating_minimum_size 900 x 600
#floating_maximum_size 900 x 600
for_window [floating] resize set 800 600

# Status Bar
bar {
    swaybar_command waybar
}



### Assigning to workspaces

assign [class="AmneziaVPN"] workspace number 10
assign [app_id="Happ"] workspace number 10
assign [app_id="qbittorrent"] workspace number 9
for_window [title="Steam" shell="xwayland"] move to workspace 6
for_window [class="steam"] move to workspace 6

exec systemctl --user import-environment WAYLAND_DISPLAY
include ~/.config/sway/*.conf
